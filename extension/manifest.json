{
  "manifest_version": 3,
  "name": "Nudge AI — Meeting Capture",
  "description": "Capture audio from Zoom/Google Meet tabs and send to Nudge AI for transcription and action item extraction.",
  "version": "1.0.0",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
