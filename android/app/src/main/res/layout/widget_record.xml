<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_widget"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Left info area: opens app -->
    <LinearLayout
        android:id="@+id/widgetInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_meetings"
                android:tint="#14B8A6"
                android:contentDescription="Nudge Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NUDGE AI"
                android:textColor="#14B8A6"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to Record"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widgetSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instant AI meeting notes"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1" />

    </LinearLayout>

    <!-- Right record / stop button -->
    <ImageButton
        android:id="@+id/widgetBtnRecord"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_widget_btn_idle"
        android:src="@drawable/ic_record"
        android:tint="#FFFFFF"
        android:scaleType="center"
        android:contentDescription="Start or Stop Recording" />

</LinearLayout>
